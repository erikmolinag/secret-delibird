DATABASE_URL="postgres://usuario:password@host/base"
AUTH_SECRET="genera con: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
# El correo intenta con uno y, si no esta, se cae al otro. Con una sola llave
# usa esa. En local las dos van vacias: el magic link sale en la consola y no le
# llega nada a un invitado de verdad.
PLUNK_API_KEY=""
RESEND_API_KEY=""
# Lo de abajo es el RESPALDO de lo que se configura en /admin. Si hay algo
# guardado en el panel, gana el panel; esto sirve para arrancar y para cuando la
# base no contesta.
EMAIL_FROM="Secret Delibird <delibird@tudominio.com>"
# Cada proveedor manda desde el dominio que tiene verificado y rechaza el
# remitente del otro. Si no estan, los dos usan EMAIL_FROM.
EMAIL_FROM_PLUNK=""
EMAIL_FROM_RESEND=""
# Cual se intenta primero: plunk o resend. Sin esto, plunk.
EMAIL_PRIMERO=""
APP_URL="http://localhost:3000"
ADMIN_EMAILS="tu@correo.com"
