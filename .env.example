DATABASE_URL="postgres://usuario:password@host/base"
AUTH_SECRET="genera con: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
# El correo intenta con Plunk y, si Plunk no esta, se cae a Resend. Con una
# sola llave usa esa. En local las dos van vacias: el magic link sale en la
# consola y no le llega nada a un invitado de verdad.
PLUNK_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="Secret Delibird <delibird@tudominio.com>"
# Opcionales: cada proveedor manda desde el dominio que tiene verificado, y
# usar el del otro hace que rechace el correo. Si no estan, los dos usan
# EMAIL_FROM.
EMAIL_FROM_PLUNK=""
EMAIL_FROM_RESEND=""
APP_URL="http://localhost:3000"
ADMIN_EMAILS="tu@correo.com"
